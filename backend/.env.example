# Server Port (Render provides this automatically as 10000)
PORT=4000

# Frontend URL for CORS (comma-separated if multiple, e.g. https://my-frontend.onrender.com,http://localhost:5173)
FRONTEND_URL=http://localhost:5173

# MongoDB Connection String (MongoDB Atlas URI in production)
MONGO_URI=mongodb://localhost:27017/flightdb

# JWT Secret for user session tokens
JWT_SECRET=supersecret_flight_jwt_key_2026

# Directory to store generated ticket PDFs
PDF_STORAGE=./tickets

# Google Gemini API Key for AI Trip Planner
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model ID (gemini-3.5-flash-lite recommended for maximum speed)
GEMINI_MODEL=gemini-3.5-flash-lite
